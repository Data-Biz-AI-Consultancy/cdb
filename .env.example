# CDB Environment Variables Configuration Template

# Environment: development | staging | production | test
ENVIRONMENT=development
PROJECT_NAME="CDB API"
DEBUG=true

# Database (PostgreSQL 16)
# Note: Host-mapped port is 5433 by default to avoid collision with 5432
POSTGRES_SERVER=cdb-db
POSTGRES_PORT=5432
POSTGRES_DB=cdb
POSTGRES_USER=cdb
POSTGRES_PASSWORD=cdb
DATABASE_URL=postgresql+asyncpg://cdb:cdb@cdb-db:5432/cdb
SYNC_DATABASE_URL=postgresql://cdb:cdb@cdb-db:5432/cdb

# Redis & Celery
REDIS_URL=redis://cdb-redis:6379/0
CELERY_BROKER_URL=redis://cdb-redis:6379/0
CELERY_RESULT_BACKEND=redis://cdb-redis:6379/0

# Security & JWT Authentication
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-this-secret-key-in-production-use-a-secure-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Service-to-Service API Key (e.g. for Jager n8n push ingestion)
CDB_API_KEY=change-this-cdb-api-key-in-production

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8000,http://localhost:8001
