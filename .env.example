# CDB Environment Variables Configuration Template

# Environment: development | staging | production | test
ENVIRONMENT=development
PROJECT_NAME="CDB API"
DEBUG=true

# Database (PostgreSQL 16)
# Note: Host-mapped port is 5433 by default to avoid collision with 5432
POSTGRES_SERVER=cdb-db
POSTGRES_PORT=5432
POSTGRES_DB=cdb
POSTGRES_USER=cdb
POSTGRES_PASSWORD=cdb
DATABASE_URL=postgresql+asyncpg://cdb:cdb@cdb-db:5432/cdb
SYNC_DATABASE_URL=postgresql://cdb:cdb@cdb-db:5432/cdb
# Optional: Production database IP or URL for scripts/clone_prod_to_dev.sh
# prod-url=192.168.178.164
# PROD_DATABASE_URL=postgresql://cdb:password@prod-host:5432/cdb

# Redis & Celery
REDIS_URL=redis://cdb-redis:6379/0
CELERY_BROKER_URL=redis://cdb-redis:6379/0
CELERY_RESULT_BACKEND=redis://cdb-redis:6379/0

# Security & JWT Authentication
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-this-secret-key-in-production-use-a-secure-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Initial Admin User (automatically seeded on startup if not present)
FIRST_SUPERUSER_EMAIL=admin@cdb.internal
FIRST_SUPERUSER_PASSWORD=admin123456
FIRST_SUPERUSER_FULL_NAME="CDB Admin"

# Self-hosted operator deployment credential for X-API-Key machine access.
# An empty value rejects every machine key. This is not a tenant API key.
CDB_API_KEY=change-this-cdb-api-key-in-production

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8000,http://localhost:8001

# Direct Connectors (self-hosted operator config; SaaS tenants use the CDB Hub vault)
# LinkedIn Member Data Portability API Token (Bearer Token)
LINKEDIN_ACCESS_TOKEN=your-linkedin-member-data-portability-token-here
# LINKEDIN_MEMBER_DATA_PORTABILITY_API_TOKEN=your-token-here
# Optional. Empty uses the neutral label "LinkedIn account".
# LINKEDIN_ACCOUNT_OWNER_NAME=

# Notion Direct Connector
# API key and database IDs are required only when Notion sync is enabled.
# Database IDs are operator-supplied (comma-separated Notion database IDs).
# NOTION_API_KEY=secret_your-notion-integration-token-here
# NOTION_SYNC_HOURS_INTERVAL=6
# NOTION_MEETING_NOTES_DATABASE_IDS=your-database-id-1,your-database-id-2

